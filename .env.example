# Client-side API origin for native builds (HTTPS).
EXPO_PUBLIC_EDIT_API_URL=https://editmypic.expo.app

# Server-only variables: set in Expo project > Environment variables.
# For EAS Hosting, choose visibility "Sensitive" and environment "production".
# Use unique random values. Never commit actual values to GitHub.
EDITMYPIC_PRIVATE_PASSWORD=replace-with-a-unique-20-plus-character-password
EDITMYPIC_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
RUNWAYML_API_SECRET=replace-with-your-runway-server-key
OPENAI_API_KEY=replace-with-your-openai-server-key

# Production builds already configure the server deploy flag in eas.json.
EXPO_UNSTABLE_DEPLOY_SERVER=1
