{
  "expo": {
    "name": "EditMyPic",
    "slug": "editmypic",
    "owner": "valdy247",
    "version": "0.10.3",
    "orientation": "default",
    "scheme": "editmypic",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valdy247.editmypic",
      "buildNumber": "12",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Elige una foto y dale tu estilo sin salir de EditMyPic.",
        "NSPhotoLibraryAddUsageDescription": "Guarda tus ediciones terminadas directamente en Fotos.",
        "NSCameraUsageDescription": "Captura una foto y empieza a editarla al instante.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.valdy247.editmypic",
      "versionCode": 12,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elige una foto y dale tu estilo sin salir de EditMyPic.",
          "cameraPermission": "Captura una foto y empieza a editarla al instante."
        }
      ],
      "expo-media-library",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "623d328f-f708-4c5a-883b-7d27fd66d7a0"
      }
    }
  }
}
